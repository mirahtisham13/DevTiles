<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/neu_shadow_dark_ambient" />
        </shape>
    </item>

    <item
        android:left="0dp"
        android:top="0dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/neu_shadow_light" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <gradient
                android:angle="135"
                android:startColor="@color/neu_surface_light"
                android:endColor="@color/neu_surface_dark"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/neu_rim_light" />
        </shape>
    </item>
</layer-list>

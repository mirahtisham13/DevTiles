<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/neu_inset_rim_dark" />
        </shape>
    </item>
    <item android:left="1.5dp" android:top="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/neu_inset_rim_light" />
        </shape>
    </item>
    <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <gradient
                android:angle="315"
                android:startColor="@color/neu_inset_surface_end"
                android:endColor="@color/neu_inset_surface_start"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
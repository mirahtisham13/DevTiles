<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom-Right Gentle Ambient Shadow -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="@color/neu_shadow_dark_ambient" />
        </shape>
    </item>

    <!-- Bottom-Right Direct Subtle Shadow -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="@color/neu_shadow_dark_direct" />
        </shape>
    </item>

    <!-- Top-Left Soft Highlight -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="@color/neu_shadow_light_soft" />
        </shape>
    </item>

    <!-- Top-Left Specular Highlight -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="@color/neu_shadow_light" />
        </shape>
    </item>

    <!-- Card Body Surface (15dp radius) -->
    <item
        android:left="2.5dp"
        android:top="2.5dp"
        android:right="2.5dp"
        android:bottom="2.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <gradient
                android:angle="135"
                android:startColor="@color/neu_surface_light"
                android:endColor="@color/neu_surface_dark"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/neu_rim_light" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom-Right Dark Shadow -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="@color/neu_shadow_dark_ambient" />
        </shape>
    </item>

    <!-- Bottom-Right Direct Shadow -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="oval">
            <solid android:color="@color/neu_shadow_dark_direct" />
        </shape>
    </item>

    <!-- Top-Left Light Highlight -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/neu_shadow_light" />
        </shape>
    </item>

    <!-- Circular Surface Body -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="@color/neu_surface_light"
                android:endColor="@color/neu_surface_dark"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/neu_rim_light" />
        </shape>
    </item>
</layer-list>

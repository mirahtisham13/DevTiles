<?xml version="1.0" encoding="utf-8"?>
<!-- Pale closing bay for technical footer within chassis -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="@color/bevel_raised_bottom" />
        </shape>
    </item>
    <item android:bottom="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="@color/bevel_raised_top" />
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:bottom="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="@color/chassis_raised" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/neu_inset_rim_dark" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/neu_inset_rim_light" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="315"
                android:startColor="@color/neu_inset_surface_end"
                android:endColor="@color/neu_inset_surface_start"
                android:type="linear" />
        </shape>
    </item>
</layer-list>

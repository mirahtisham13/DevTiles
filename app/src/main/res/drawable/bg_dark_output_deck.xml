<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="6dp"
        android:top="6dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/neu_shadow_dark_ambient" />
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/neu_shadow_dark_direct" />
        </shape>
    </item>
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/neu_shadow_light_soft" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/neu_shadow_light" />
        </shape>
    </item>
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="135"
                android:startColor="@color/neu_surface_light"
                android:endColor="@color/neu_surface_dark"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/neu_rim_light" />
        </shape>
    </item>
</layer-list>

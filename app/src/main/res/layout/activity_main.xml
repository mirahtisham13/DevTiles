<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neu_bg"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="28dp"
        android:paddingBottom="40dp">

        <!-- ========================================================= -->
        <!-- 1. TOP HEADER (3-dash menu removed)                       -->
        <!-- ========================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- App Title, Subtle Status Indicator, and Subtitle -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DevTiles"
                    android:textColor="@color/neu_text_primary"
                    android:textSize="26sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Developer quick-settings tiles"
                    android:textColor="@color/neu_text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Root Status Chip with indicator dot -->
            <LinearLayout
                android:id="@+id/rootStatusContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neu_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <!-- Red if unrooted, green if rooted -->
                <View
                    android:id="@+id/rootStatusDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_neu_status_dot_red" />

                <TextView
                    android:id="@+id/rootStatusChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UNROOTED"
                    android:textColor="@color/neu_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04" />
            </LinearLayout>
        </LinearLayout>

        <!-- ========================================================= -->
        <!-- 2. PERMISSION STATUS (Subtle Soft Status Card)            -->
        <!-- ========================================================= -->
        <LinearLayout
            android:id="@+id/permissionStatusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neu_card_granted"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginBottom="18dp">

            <!-- Green Check Icon / Indicator Socket -->
            <TextView
                android:id="@+id/permissionStatusIcon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/neu_success"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_neu_icon_socket" />

            <!-- Text Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/permissionStatusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Permission Granted"
                    android:textColor="@color/neu_text_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/permissionStatusDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="All tiles are ready to use."
                    android:textColor="@color/neu_text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>
        </LinearLayout>

        <!-- ADB Grant Command Terminal (Only shown if permission required) -->
        <LinearLayout
            android:id="@+id/adbCommandCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neu_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADB GRANT COMMAND"
                android:textColor="@color/neu_text_primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Recessed Code Box -->
            <TextView
                android:id="@+id/adbCommandText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neu_terminal"
                android:padding="12dp"
                android:text="adb shell pm grant com.devtiles android.permission.WRITE_SECURE_SETTINGS"
                android:textColor="@color/neu_terminal_code"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.3"
                android:textIsSelectable="true" />

            <!-- Action Row: ? Help Button + Copy Command Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Small ? Icon Button in front of copy command -->
                <FrameLayout
                    android:id="@+id/helpTooltipBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_neu_btn_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Help">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="?"
                        android:textColor="@color/neu_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />
                </FrameLayout>

                <!-- Copy Command Button (14dp rounded) -->
                <LinearLayout
                    android:id="@+id/copyCommandBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_neu_btn_primary"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_neu_copy"
                        app:tint="@color/neu_text_primary"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Copy" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COPY COMMAND"
                        android:textColor="@color/neu_text_primary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ========================================================= -->
        <!-- 4. AVAILABLE TILES                                        -->
        <!-- ========================================================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Available Tiles"
            android:textColor="@color/neu_text_primary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="10dp" />

        <!-- Tile 1: Developer Options -->
        <LinearLayout
            android:id="@+id/cardTileDevOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neu_card_selector"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="10dp">

            <!-- Neumorphic Icon Socket -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_neu_icon_socket"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_developer_mode"
                    app:tint="@color/neu_text_primary"
                    android:contentDescription="Dev Options" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Developer Options"
                    android:textColor="@color/neu_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Toggle developer options on/off"
                    android:textColor="@color/neu_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neu_chip"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="+ ADD"
                android:textColor="@color/neu_text_primary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <!-- Tile 2: USB Debugging -->
        <LinearLayout
            android:id="@+id/cardTileUsb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neu_card_selector"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="10dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_neu_icon_socket"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_usb"
                    app:tint="@color/neu_text_primary"
                    android:contentDescription="USB Debugging" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USB Debugging"
                    android:textColor="@color/neu_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Toggle USB debugging on/off"
                    android:textColor="@color/neu_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neu_chip"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="+ ADD"
                android:textColor="@color/neu_text_primary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <!-- Tile 3: Private DNS -->
        <LinearLayout
            android:id="@+id/cardTileDns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neu_card_selector"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="10dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_neu_icon_socket"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_dns"
                    app:tint="@color/neu_text_primary"
                    android:contentDescription="Private DNS" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Private DNS"
                    android:textColor="@color/neu_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Toggle between Off and your configured custom DNS"
                    android:textColor="@color/neu_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neu_chip"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="+ ADD"
                android:textColor="@color/neu_text_primary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <!-- Tile 4: Network Mode -->
        <LinearLayout
            android:id="@+id/cardTileNetwork"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neu_card_selector"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_neu_icon_socket"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_network_mode"
                    app:tint="@color/neu_text_primary"
                    android:contentDescription="Network Mode" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Network Mode"
                    android:textColor="@color/neu_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Open Phone Info to set 4G / 5G network mode"
                    android:textColor="@color/neu_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neu_chip"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="+ ADD"
                android:textColor="@color/neu_text_primary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <!-- Card 5: Manage Apps -->
        <LinearLayout
            android:id="@+id/cardTileManageApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neu_card_selector"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="18dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_neu_icon_socket"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_manage_apps"
                    app:tint="@color/neu_text_primary"
                    android:contentDescription="Manage Apps" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage Apps"
                    android:textColor="@color/neu_text_primary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Open installed applications and permissions"
                    android:textColor="@color/neu_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />

                <!-- Compatibility Note -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Note: Only available for Xiaomi/Redmi/Poco devices"
                    android:textColor="@color/neu_warning"
                    android:textSize="10.5sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neu_chip"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="+ ADD"
                android:textColor="@color/neu_text_primary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <!-- ========================================================= -->
        <!-- 5. OPERATIONS MANUAL (Collapsible / Compact Help)         -->
        <!-- ========================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neu_card"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Section Header (Clickable to toggle) -->
            <LinearLayout
                android:id="@+id/helpSectionToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="How to Add Tiles"
                    android:textColor="@color/neu_text_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/helpExpandIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_neu_expand"
                    app:tint="@color/neu_text_secondary"
                    android:contentDescription="Expand" />
            </LinearLayout>

            <!-- Collapsible Step Content -->
            <LinearLayout
                android:id="@+id/helpSectionContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="14dp"
                android:visibility="visible">

                <!-- Step 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:gravity="center"
                        android:background="@drawable/bg_neu_step_socket"
                        android:text="1"
                        android:textColor="@color/neu_text_primary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pull down twice to open Quick Settings"
                        android:textColor="@color/neu_text_secondary"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <!-- Step 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:gravity="center"
                        android:background="@drawable/bg_neu_step_socket"
                        android:text="2"
                        android:textColor="@color/neu_text_primary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tap the Edit (pencil) icon"
                        android:textColor="@color/neu_text_secondary"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <!-- Step 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:gravity="center"
                        android:background="@drawable/bg_neu_step_socket"
                        android:text="3"
                        android:textColor="@color/neu_text_primary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Drag DevTiles to your active tiles panel"
                        android:textColor="@color/neu_text_secondary"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <!-- Step 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:gravity="center"
                        android:background="@drawable/bg_neu_step_socket"
                        android:text="4"
                        android:textColor="@color/neu_text_primary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tap Done"
                        android:textColor="@color/neu_text_secondary"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
